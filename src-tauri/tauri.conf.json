{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "聚序智投",
  "version": "0.1.3",
  "identifier": "me.ofo.syntropy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["pytauri/standalone"]
  },
  "app": {
    "windows": [
      {
        "title": "聚序智投",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.ofo.me/syntropy/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3ODJDQUMyRTMyOTYzQjUKUldTMVl5bmp3c3FDRjVFZUswdWxCUkc0d3ViNVdWSm13eTR5cVRhVUJpdVlLbXFiZ2dPVDM4L2kK",
      "dialog": false
    }
  }
}
